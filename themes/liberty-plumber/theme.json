{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "820px",
			"wideSize": "1260px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"name": "Cool Slate Canvas (Background)",
					"slug": "ivory",
					"color": "#F8FAFC"
				},
				{
					"name": "Pure Surface (Card)",
					"slug": "surface",
					"color": "#FFFFFF"
				},
				{
					"name": "Soft Hydro Tint (Section Alt)",
					"slug": "linen",
					"color": "#EFF6FF"
				},
				{
					"name": "Soft Copper Tint",
					"slug": "copper-tint",
					"color": "#FFEDD5"
				},
				{
					"name": "Deep Liberty Navy (Headings)",
					"slug": "navy",
					"color": "#0B2545"
				},
				{
					"name": "Deep Slate Ink (Body)",
					"slug": "ink",
					"color": "#0F172A"
				},
				{
					"name": "Muted Slate",
					"slug": "slate-muted",
					"color": "#475569"
				},
				{
					"name": "Safety Copper (Primary CTA)",
					"slug": "copper",
					"color": "#C2410C"
				},
				{
					"name": "Deep Copper (Hover)",
					"slug": "copper-hover",
					"color": "#9A3412"
				},
				{
					"name": "Emergency Dispatch Red",
					"slug": "crimson",
					"color": "#B91C1C"
				},
				{
					"name": "Hairline Border",
					"slug": "border",
					"color": "#CBD5E1"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "Industrial Geometric Sans",
					"slug": "display",
					"fontFamily": "ui-sans-serif, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"name": "Clean Readable Sans",
					"slug": "sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"name": "Dispatch Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"slug": "xs",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"name": "Base",
					"slug": "medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "Extra Large (H3)",
					"slug": "x-large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "2XL Section Heading (H2)",
					"slug": "xx-large",
					"size": "2.35rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.35rem"
					}
				},
				{
					"name": "Display Hero (H1)",
					"slug": "display",
					"size": "3.25rem",
					"fluid": {
						"min": "2.15rem",
						"max": "3.25rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "name": "2XS", "slug": "20", "size": "0.5rem" },
				{ "name": "XS", "slug": "30", "size": "0.875rem" },
				{ "name": "Small", "slug": "40", "size": "1.25rem" },
				{ "name": "Medium", "slug": "50", "size": "1.875rem" },
				{ "name": "Large", "slug": "60", "size": "2.75rem" },
				{ "name": "XL", "slug": "70", "size": "4rem" },
				{ "name": "2XL Section", "slug": "80", "size": "5.5rem" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft Service Card",
					"slug": "card",
					"shadow": "0 12px 32px -8px rgba(11, 37, 69, 0.08), 0 2px 6px -1px rgba(11, 37, 69, 0.04)"
				},
				{
					"name": "Elevated Hover",
					"slug": "elevated",
					"shadow": "0 20px 44px -12px rgba(11, 37, 69, 0.14), 0 4px 12px -2px rgba(11, 37, 69, 0.06)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 2.5rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "800",
					"lineHeight": "1.18",
					"letterSpacing": "-0.02em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.28",
					"letterSpacing": "-0.015em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--copper)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--copper-hover)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--copper)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "999px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.9375rem",
					"fontWeight": "700",
					"lineHeight": "1.25"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.55rem",
						"bottom": "0.85rem",
						"left": "1.55rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--copper-hover)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontSize": "1.4rem",
					"fontWeight": "800",
					"letterSpacing": "-0.02em",
					"textDecoration": "none"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem",
					"fontWeight": "600"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Plumbing Header with Emergency Dispatch Bar",
			"area": "header"
		},
		{
			"name": "header-minimal",
			"title": "Minimal Funnel Header (Logo & Phone Only)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Plumbing Footer with Dispatch Hours & Service Areas",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (No Title / Pattern Ready)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-canvas",
			"title": "Full-Width Pattern Canvas",
			"postTypes": [ "page", "post" ]
		},
		{
			"name": "page-blank",
			"title": "Blank Canvas (No Header or Footer)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-services",
			"title": "Plumbing Services Directory Page",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-water-heaters",
			"title": "Water Heaters & Tankless Page",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-contact",
			"title": "Contact & Dispatch Scheduling Page",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-emergency",
			"title": "Emergency Plumbing Funnel (Minimal Header)",
			"postTypes": [ "page" ]
		}
	]
}
