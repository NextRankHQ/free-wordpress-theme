{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Warm Ivory (Canvas)",
					"slug": "ivory",
					"color": "#FAF8F4"
				},
				{
					"name": "Pure Surface (Card)",
					"slug": "surface",
					"color": "#FFFFFF"
				},
				{
					"name": "Soft Linen (Section Alt)",
					"slug": "linen",
					"color": "#F1EDE4"
				},
				{
					"name": "Clinical Sage Tint",
					"slug": "sage-tint",
					"color": "#E4F0ED"
				},
				{
					"name": "Harbor Navy (Headings)",
					"slug": "navy",
					"color": "#102538"
				},
				{
					"name": "Slate Ink (Body)",
					"slug": "ink",
					"color": "#243647"
				},
				{
					"name": "Muted Slate",
					"slug": "slate-muted",
					"color": "#4E6172"
				},
				{
					"name": "Clinical Sage (Primary CTA)",
					"slug": "sage",
					"color": "#1E625B"
				},
				{
					"name": "Deep Sage (Hover)",
					"slug": "sage-hover",
					"color": "#154944"
				},
				{
					"name": "Warm Terracotta (Urgent / Accent)",
					"slug": "terracotta",
					"color": "#984028"
				},
				{
					"name": "Hairline Border",
					"slug": "border",
					"color": "#DDD7CC"
				}
			],
			"gradients": [
				{
					"name": "Warm Practice Wash",
					"slug": "warm-wash",
					"gradient": "linear-gradient(180deg, #FAF8F4 0%, #F1EDE4 100%)"
				},
				{
					"name": "Harbor Clinical Banner",
					"slug": "harbor-banner",
					"gradient": "linear-gradient(135deg, #102538 0%, #1B3B56 100%)"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"name": "2XS (6px)",
					"slug": "20",
					"size": "0.375rem"
				},
				{
					"name": "XS (12px)",
					"slug": "30",
					"size": "0.75rem"
				},
				{
					"name": "Small (20px)",
					"slug": "40",
					"size": "1.25rem"
				},
				{
					"name": "Medium (32px)",
					"slug": "50",
					"size": "clamp(1.5rem, 2.5vw, 2rem)"
				},
				{
					"name": "Large (48px)",
					"slug": "60",
					"size": "clamp(2.25rem, 4vw, 3rem)"
				},
				{
					"name": "XL (76px)",
					"slug": "70",
					"size": "clamp(3.25rem, 6vw, 4.75rem)"
				},
				{
					"name": "2XL (108px)",
					"slug": "80",
					"size": "clamp(4.25rem, 8vw, 6.75rem)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"name": "Editorial Serif",
					"slug": "serif",
					"fontFamily": "\"Iowan Old Style\", \"Palatino Linotype\", \"URW Palladio L\", P052, Georgia, serif"
				},
				{
					"name": "Clinical Humanist Sans",
					"slug": "sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"name": "Clinical Tabular Mono",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Caption",
					"slug": "xs",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"name": "Base",
					"slug": "medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"name": "Lead",
					"slug": "large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "Card Heading",
					"slug": "x-large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "Section Heading",
					"slug": "xx-large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.875rem",
						"max": "2.5rem"
					}
				},
				{
					"name": "Display Hero",
					"slug": "display",
					"size": "3.375rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.375rem"
					}
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Subtle Card",
					"slug": "card",
					"shadow": "0 8px 24px -8px rgba(16, 37, 56, 0.07), 0 1px 3px rgba(16, 37, 56, 0.04)"
				},
				{
					"name": "Elevated Float",
					"slug": "elevated",
					"shadow": "0 20px 44px -12px rgba(16, 37, 56, 0.13), 0 2px 6px rgba(16, 37, 56, 0.05)"
				}
			]
		},
		"custom": {
			"radius": {
				"sm": "8px",
				"md": "14px",
				"lg": "22px",
				"pill": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.68"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1.25rem, 4vw, 2.5rem)",
				"right": "clamp(1.25rem, 4vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "600",
					"lineHeight": "1.18",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.18"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.26"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "1.125rem",
					"fontWeight": "600",
					"letterSpacing": "-0.01em",
					"lineHeight": "1.35"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--sage)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					},
					"typography": {
						"textDecoration": "none"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sage)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "0.82rem",
						"bottom": "0.82rem",
						"left": "1.55rem",
						"right": "1.55rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.95rem",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--sage-hover)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.95rem",
					"fontWeight": "500"
				},
				"color": {
					"text": "var(--wp--preset--color--navy)"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.45rem",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--navy)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				},
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--sage)",
					"style": "solid",
					"width": "0 0 0 3px"
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Clinic Header (With Top Bar)",
			"area": "header"
		},
		{
			"name": "header-minimal",
			"title": "Minimal Funnel Header (Distraction-Free)",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Practice Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page — No Title (Start with Hero Pattern)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-canvas",
			"title": "Full-Width Canvas",
			"postTypes": [ "page", "post" ]
		},
		{
			"name": "page-blank",
			"title": "Blank Canvas (No Header or Footer)",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-doctors",
			"title": "Our Doctors & Providers Directory",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-services",
			"title": "Dental & Clinical Services Hub",
			"postTypes": [ "page" ]
		}
	]
}
