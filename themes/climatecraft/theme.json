{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1260px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"name": "Alpine Mist Canvas",
					"slug": "ivory",
					"color": "#F4F7FB"
				},
				{
					"name": "Engineered Steel Frost",
					"slug": "linen",
					"color": "#E2E8F0"
				},
				{
					"name": "Pure White Surface",
					"slug": "surface",
					"color": "#FFFFFF"
				},
				{
					"name": "Deep Obsidian Ink",
					"slug": "ink",
					"color": "#090D16"
				},
				{
					"name": "Architectural Slate",
					"slug": "slate-muted",
					"color": "#334155"
				},
				{
					"name": "Midnight Carbon Navy",
					"slug": "navy",
					"color": "#090D16"
				},
				{
					"name": "Glacier Cooling Blue",
					"slug": "copper",
					"color": "#0284C7"
				},
				{
					"name": "Deep Subzero Cyan",
					"slug": "copper-dark",
					"color": "#0369A1"
				},
				{
					"name": "Soft Glacier Mist",
					"slug": "copper-tint",
					"color": "#E0F2FE"
				},
				{
					"name": "Solar Heating Flame",
					"slug": "brass",
					"color": "#C2410C"
				},
				{
					"name": "Warm Furnace Glow",
					"slug": "brass-tint",
					"color": "#FFEDD5"
				},
				{
					"name": "Structural Hairline",
					"slug": "border",
					"color": "#CBD5E1"
				}
			],
			"gradients": [
				{
					"name": "Thermal Comfort Wash",
					"slug": "editorial-wash",
					"gradient": "linear-gradient(135deg, #F8FAFC 0%, #EFF6FF 52%, #FFEDD5 100%)"
				},
				{
					"name": "Deep Thermal Navy Banner",
					"slug": "navy-clinical",
					"gradient": "linear-gradient(135deg, #0A2540 0%, #0F3460 100%)"
				},
				{
					"name": "Furnace Flame Accent",
					"slug": "copper-dispatch",
					"gradient": "linear-gradient(135deg, #C2410C 0%, #9A3412 100%)"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"name": "2XS",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "XS",
					"slug": "30",
					"size": "0.875rem"
				},
				{
					"name": "Small",
					"slug": "40",
					"size": "1.25rem"
				},
				{
					"name": "Medium",
					"slug": "50",
					"size": "2rem"
				},
				{
					"name": "Large",
					"slug": "60",
					"size": "3rem"
				},
				{
					"name": "XL",
					"slug": "70",
					"size": "4.5rem"
				},
				{
					"name": "2XL",
					"slug": "80",
					"size": "6rem"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"fontFamilies": [
				{
					"name": "Industrial Sans",
					"slug": "sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Inter, Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"name": "Editorial Serif",
					"slug": "serif",
					"fontFamily": "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif"
				},
				{
					"name": "Technical Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Extra Small",
					"slug": "xs",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"name": "Base",
					"slug": "medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"name": "Lead",
					"slug": "large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"name": "Subheading (H3)",
					"slug": "x-large",
					"size": "1.5rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"name": "Section Title (H2)",
					"slug": "xx-large",
					"size": "2.35rem",
					"fluid": {
						"min": "1.8rem",
						"max": "2.45rem"
					}
				},
				{
					"name": "Hero Display (H1)",
					"slug": "display",
					"size": "3.25rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.35rem"
					}
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Soft Card Shadow",
					"slug": "card",
					"shadow": "0 12px 32px -8px rgba(10, 37, 64, 0.08), 0 4px 12px -2px rgba(10, 37, 64, 0.04)"
				},
				{
					"name": "Elevated Hover Shadow",
					"slug": "elevated",
					"shadow": "0 22px 48px -12px rgba(10, 37, 64, 0.15), 0 6px 16px -4px rgba(10, 37, 64, 0.07)"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0px",
				"right": "clamp(1.25rem, 4vw, 2.5rem)",
				"bottom": "0px",
				"left": "clamp(1.25rem, 4vw, 2.5rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--copper)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--navy)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--navy)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "800",
					"lineHeight": "1.16",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "700",
					"lineHeight": "1.28"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--brass)",
					"text": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "10px"
				},
				"spacing": {
					"padding": {
						"top": "0.85rem",
						"right": "1.65rem",
						"bottom": "0.85rem",
						"left": "1.65rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--copper-dark)",
						"text": "var(--wp--preset--color--surface)"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--copper)"
							}
						}
					}
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "1.35rem",
					"fontWeight": "800",
					"letterSpacing": "-0.02em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--navy)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"color": "var(--wp--preset--color--copper)",
					"style": "solid",
					"width": "0 0 0 4px"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"right": "1.25rem",
						"bottom": "0.5rem",
						"left": "1.5rem"
					}
				},
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "HVAC Header with Dispatch Bar",
			"area": "header"
		},
		{
			"name": "header-minimal",
			"title": "Minimal Landing Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "HVAC Footer with Dispatch Hours & Social Links",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-services",
			"title": "Heating, Cooling & IAQ Services Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-heat-pumps",
			"title": "Heat Pumps, AC & SEER2 Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-contact",
			"title": "Contact & 24/7 HVAC Dispatch Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-emergency",
			"title": "24/7 Emergency HVAC Triage Page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-no-title",
			"title": "Page Without Title Banner",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-blank",
			"title": "Blank Canvas (No Header / Footer)",
			"postTypes": [
				"page",
				"post"
			]
		},
		{
			"name": "page-canvas",
			"title": "Full-Bleed Builder Canvas (With Header & Footer)",
			"postTypes": [
				"page"
			]
		}
	]
}
